{
  "name": "evanta-os-root",
  "version": "1.0.0",
  "private": true,
  "description": "EVanta OS - EV Charging Intelligence & Business Management Platform",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File .\\run.ps1",
    "dev:backend": "cd backend && .venv\\Scripts\\python -m uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "test:backend": "cd backend && .venv\\Scripts\\pytest",
    "lint:frontend": "cd frontend && npm run lint",
    "build:frontend": "cd frontend && npm run build"
  }
}
